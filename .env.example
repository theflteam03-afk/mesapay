# Copie para .env:  cp .env.example .env
# Para desenvolvimento local nada aqui precisa de conta externa.

# ── Banco de dados (PostgreSQL) ─────────────────────────────────────────
# Local com docker compose (padrão):  docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mesapay"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mesapay"
# Local com Supabase CLI (supabase start) use a porta 54322 e o banco "postgres".
# Produção (Supabase): DATABASE_URL = string do "Transaction pooler" (porta 6543),
#                      DIRECT_URL   = string "Direct connection" (porta 5432) — usada nas migrações.

# ── Supabase (Realtime + Storage, usado a partir da Fase 2) ─────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── URLs dos apps ───────────────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# ── Segredos (gerar cada um com: openssl rand -base64 32) ───────────────
# Em desenvolvimento, se ficarem vazios, é usado um valor fixo só de dev.
# Em produção são obrigatórios.
AUTH_SECRET=""
PIN_PEPPER=""
PRINT_AGENT_SECRET=""

# ── Pagamentos (Fase 5) ─────────────────────────────────────────────────
PAYMENT_PROVIDER="fake"          # fake | mercadopago
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
MP_MARKETPLACE_FEE_PCT="0"

# ── Google (Places / avaliação) ─────────────────────────────────────────
GOOGLE_PLACES_API_KEY=""

# ── E-mail (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="MesaPay <ola@mesapay.com.br>"

# ── Rate limiting (vazio = em memória, só serve para dev) ───────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Monitorização ───────────────────────────────────────────────────────
SENTRY_DSN=""

# ── Agente de impressão local (apps/print-agent) ───────────────────────
PRINT_AGENT_PORT="3010"
